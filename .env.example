# Either provide a full ODBC connection string...
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Uid=<user>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;
# ...or the individual settings below.
AZURE_SQL_SERVER=<server>.database.windows.net
AZURE_SQL_DATABASE=<database>
AZURE_SQL_USERNAME=<username>
AZURE_SQL_PASSWORD=<password>
# Optional: AZURE_SQL_AUTHENTICATION=ActiveDirectoryMsi (omit username/password)
# Optional: AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Azure Blob Storage for original report PDFs. Authenticate locally with `az login`;
# hosted Azure resources should use a managed identity with Storage Blob Data Contributor.
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
# Optional: defaults to permit-reports
AZURE_STORAGE_CONTAINER=permit-reports
